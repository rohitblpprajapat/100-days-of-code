    "# ─── CELL 5 : Transcript normalisation helper ────────────────────────────────\n",
    "\n",
    "def normalise_text(text: str) -> str:\n",
    "    \"\"\"\n",
    "    Light normalisation applied consistently to both reference and prediction:\n",
    "    - Unicode NFC normalisation\n",
    "    - Lower-case\n",
    "    - Collapse whitespace\n",
