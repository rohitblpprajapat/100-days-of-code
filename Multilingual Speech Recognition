    "# ── CELL 10 : Updated transcribe_batch (one-by-one internally) ──\n",
    "def transcribe_batch(audio_paths):\n",
    "    transcripts = []\n",
    "    for p in audio_paths:\n",
    "        audio  = load_audio(p)\n",
    "        inp    = {\"array\": audio, \"sampling_rate\": SAMPLE_RATE}\n",
    "        result = asr_pipe(inp)\n",
    "        if isinstance(result, list):\n",
    "            text = \" \".join(c[\"text\"] for c in result).strip()\n",
    "        else:\n",
    "            text = result.get(\"text\", \"\").strip()\n",
    "        transcripts.append(text)\n",
    "    return transcripts"
   ]
