    "    device            = DEVICE,\n",
    "    generate_kwargs   = {\n",
    "        \"task\"          : \"transcribe\",\n",
    "        \"max_new_tokens\": MAX_NEW_TOKENS,\n",
    "        # language=None → auto-detect per sample\n",
    "    },\n",
    ")"
